# Copy to .env and adjust. Defaults match a stock XAMPP MySQL install.
PORT=5000
CLIENT_ORIGIN=http://localhost:3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=library_db

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=50

FINE_PER_DAY_ETB=5

OAI_REPOSITORY_NAME=Wolkite University Institutional Repository
OAI_BASE_URL=http://localhost:5000/oai
OAI_ADMIN_EMAIL=library@wku.edu.et
